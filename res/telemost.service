[Unit]
Description=Telemost
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/telemost --service
# kill --tray and --server both
ExecStop=pkill -f "telemost --"
# below two lines do not work, have to use above one line
#ExecStop=pkill -f "telemost --tray"
#ExecStop=pkill -f "telemost --server"
PIDFile=/run/telemost.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
